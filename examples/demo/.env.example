# Devnet only. Never put a mainnet key, or any key controlling real value, in this file.
# Copy this to examples/demo/.env (gitignored, never committed) and fill in real values to
# run `npm run demo` against Solana devnet instead of `npm run demo -- --mock`.

# Solana devnet RPC endpoint. Optional: defaults to https://api.devnet.solana.com if unset.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Path to a funded devnet keypair JSON file (the format `solana-keygen new` produces).
# Required for direct mode (the default, no flags) and --x402.
SOLANA_KEYPAIR_PATH=./devnet-keypair.json

# Devnet USDC recipient the demo pays. Required for direct mode.
VENDOR_ADDRESS=

# Port the demo's local 402-protected vendor listens on for the --x402 act. Optional: defaults
# to 3001 if unset.
VENDOR_PORT=3001
