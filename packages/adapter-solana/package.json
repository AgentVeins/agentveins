{
  "name": "@agentveins/adapter-solana",
  "version": "0.5.0",
  "description": "Solana wallet adapter for AgentVeins: USDC settlement on devnet, direct or x402.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentVeins/agentveins.git",
    "directory": "packages/adapter-solana"
  },
  "homepage": "https://github.com/AgentVeins/agentveins#readme",
  "bugs": "https://github.com/AgentVeins/agentveins/issues",
  "keywords": [
    "ai-agents",
    "payments",
    "solana",
    "usdc",
    "x402",
    "spend-controls"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@agentveins/core": "^0.5.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.0.0",
    "@x402/core": "^2.22.0"
  },
  "devDependencies": {
    "@x402/svm": "^2.22.0"
  },
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "tsc --build --force && vitest run --root ../..",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:devnet": "vitest run --root ../.. --testNamePattern devnet packages/adapter-solana/test/devnet.test.ts"
  }
}
